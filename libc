1 read(a,b,c)  //从a读取数据到b,单次读取数据最大值为c。返回值为读取的字节数（不包含\0）。a=0代表标准输入流。执行条件：读取到数据；读满缓冲区；遇到EOF。
                终端手动交互要用换行符清空缓冲区，换行符不可避免被读入。（总之，不需要换行符来终止读入）
                                                                                                                                                                                                              
2 fopen("文件路径", "r");    //用于初始化文件结构体

3 fgets(a, b, c);      //从来源c读取数据到a，单次最多b个字节的数据

4 signal(a, b);    //发生a类型错误时，执行b函数

5 write(a,b,c)函数的3个参数分别是文件描述（1标准输出，0输入，2错误）；地址；单次最多读取多少字节数据

6 printf    //
    %n:把已经输出的字符的数量写入指定地址(把栈上的信息当作地址再覆写这个地址对应值)
    %t$p：表示第t个参数

7 system("/bin/sh")        ——开启shell

8 memset(目标地址, 填充值, 长度);

9 __isoc99_scanf就是平时用的scanf函数。读取的是字符数据。只有遇到空格，换行、tab、EOF才停止

10 void *memcpy(void *dest, const void *src, size_t n);   从 src 指向的内存复制 n 个字节到 dest 指向的内存。

11 fgets(目标地址, 最大读取长度, 标准输入);    //会保留换行符
